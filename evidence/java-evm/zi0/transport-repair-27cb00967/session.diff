+func canonicalPackedRecord(p [32]byte) bool {
+	if common.Hash(p) == (common.Hash{}) {
+		return false
+	}
+	// Bits 195..255 are frozen zero. In ABI's big-endian bytes32 these are
+	// bytes 0..6 and the high five bits of byte 7.
+	for i := 0; i < 7; i++ {
+		if p[i] != 0 {
+			return false
+		}
+	}
+	return p[7]&0xf8 == 0
+}
